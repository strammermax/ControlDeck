[Unit]
Description=ControlDeck Homelab Control Center
After=network.target

[Service]
Type=simple
User=controldeck
Group=controldeck
WorkingDirectory=/opt/controldeck/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/controldeck/current/venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 1 --threads 2 --worker-tmp-dir /tmp backend.app:app
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/controldeck
UMask=0027

[Install]
WantedBy=multi-user.target
